[user]
  name = Eldar Iskhakov
  email = iskhakov.e11@gmail.com
  signingkey = /Users/eldar/.ssh/id_ed25519.pub
[core]
  excludesfile = ~/.gitignore_global
  editor = nvim
[push]
  default = matching
[alias]
  df = diff
  st = status
  ci = commit
  br = branch -v
  co = checkout
  lg = log --pretty=format:\"%h %Cblue%ai  %Cgreen%an%Creset: %s %Cred%d\"
  lf = log --name-status --pretty=format:\"%h %Cblue%ar %Cgreen%an%Creset: %s %Cred%d\"
  ll = log -10 --pretty=format:\"%Cred%h %Cblue%ar%Creset %Cgreen%an%Creset %s %Cred%d\"
  gr = log --graph --pretty=format:\"%Cred%h %Cblue%ar%Creset %Cgreen%an%Creset %s %Cred%d\"
  where = branch -av --contains
  sb = show-branch
  url =! bash -c 'git config --get remote.origin.url | sed -E "s/.+:\\(.+\\)\\.git$/https:\\\\/\\\\/github\\\\.com\\\\/\\\\1/g"'
[checkout]
    defaultRemote = origin
# [diff]
#   external = difft
[gpg]
  format = ssh
[commit]
  gpgsign = true
[gpg "ssh"]
  allowedSignersFile = /Users/eldar/.config/git/allowed_signers
[includeIf "gitdir:~/projects/hoodies/"]
    path = ~/.gitconfig-hoodies
