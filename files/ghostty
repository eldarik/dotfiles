font-family = Anonymous Pro
font-style = "Bold"
font-size = 15

# adjust-cell-height = -10%

cursor-style = block
mouse-hide-while-typing = true

# Follows the macOS appearance automatically. Custom themes live in
# ~/.config/ghostty/themes/ (see files/ghostty-themes/) and carry the palette
# tweaks that used to sit in this file — palette lines here would apply to both
# modes and break dark.
theme = light:solarized-light,dark:solarized-dark

window-colorspace = "display-p3"
# uncomment if tabs are not needed
window-decoration = none
window-padding-x = 5

cursor-invert-fg-bg = true
cursor-style-blink = false
cursor-style=block
shell-integration-features = no-cursor

keybind = cmd+s>r=reload_config

copy-on-select = false
